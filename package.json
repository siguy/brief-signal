{
  "name": "brief-signal",
  "version": "1.0.0",
  "description": "Brief Signal — Weekly AI market intelligence for startup conversations",
  "scripts": {
    "build:css": "tailwindcss -i input.css -o static/style.css",
    "build": "npm run build:css && node build.js",
    "fetch-images": "node fetch-og.js",
    "audio": "node scripts/generate-audio-script.js",
    "audio:pr": "node scripts/generate-audio-script.js --pr",
    "audio:generate": "node scripts/generate-audio.js",
    "preview": "npm run build && open dist/index.html",
    "notify": "node scripts/send-email.js",
    "featured": "node scripts/get-featured-topics.js",
    "analytics": "node scripts/fetch-analytics.js",
    "snapshot": "./scripts/snapshot-briefing.sh",
    "lineup": "node scripts/generate-briefing.js --lineup-only",
    "redraft": "node scripts/generate-briefing.js --from-lineup",
    "signal": "node scripts/signal-digest.js",
    "labnews": "node scripts/fetch-lab-news.js",
    "test": "node scripts/generate-briefing.test.js && node scripts/lint-briefing.test.js && node scripts/signal-digest.test.js && node scripts/lineup-digest.test.js && node scripts/fetch-lab-news.test.js && node fetch-og.test.js && bash scripts/generate-weekly.test.sh"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/genai": "^1.43.0",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.4.2",
    "marked": "^15.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.2.1"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "brace-expansion": "^2.1.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1"
  }
}
